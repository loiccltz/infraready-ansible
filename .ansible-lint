---
# Regles ignorees, avec leur justification (voir README, section Qualite et integration continue) :
skip_list:
  - command-instead-of-module  # systemctl is-active : verifications en lecture seule
  - package-latest             # mise a jour controlee d'un paquet : la derniere version est voulue
  - run-once[task]             # plays lineaires ; le MSI n'est telecharge qu'une fois
  - no-handler                 # journal de maintenance ecrit seulement si des paquets ont change
